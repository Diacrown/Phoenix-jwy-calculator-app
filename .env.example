# Copy to .env for `netlify dev`. On the live site set these in Netlify > Site configuration > Environment variables.
# Never commit real values.

# Locks the save / search / email functions. Pick a long random string (e.g. `openssl rand -base64 24`).
APP_ACCESS_KEY=

# Email (Resend). RESEND_FROM_ADDRESS must be on a domain you have verified in Resend to email customers.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Phoenix Quotes <quotes@your-domain.com>

# Save to Drive (Google Cloud OAuth "Web application" client id + the target Drive folder id). Both are public identifiers.
GOOGLE_CLIENT_ID=
GOOGLE_DRIVE_FOLDER_ID=

# The database needs no settings: Netlify Database is provisioned and connected automatically on deploy.
